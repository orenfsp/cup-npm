POSTGRES_DB=otklik
POSTGRES_USER=otklik
POSTGRES_PASSWORD=replace_me

DATABASE_URL=postgresql+asyncpg://otklik:replace_me@localhost:5432/otklik
VALKEY_URL=redis://localhost:6379/0

JWT_SECRET=replace_with_at_least_32_random_bytes
JWT_ISSUER=otklik-api
JWT_AUDIENCE=otklik-staff
TRACK_HMAC_SECRET=replace_with_at_least_32_random_bytes
RATE_LIMIT_HMAC_SECRET=replace_with_at_least_32_random_bytes
REFRESH_TOKEN_HMAC_SECRET=replace_with_at_least_32_random_bytes
APPLICANT_ACCESS_JWT_SECRET=replace_with_a_different_32_byte_secret
CONTENT_ENCRYPTION_KEY=replace_with_urlsafe_base64_of_32_random_bytes
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_SESSION_TTL_DAYS=7
REFRESH_COOKIE_NAME=otklik_staff_refresh
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
APPLICANT_ACCESS_TTL_MINUTES=30
APPLICANT_ACCESS_COOKIE_NAME=otklik_appeal_access
TRACK_ACCESS_RATE_LIMIT_ATTEMPTS=5
TRACK_ACCESS_RATE_LIMIT_WINDOW_SECONDS=60
APPEAL_SUBMISSION_RATE_LIMIT_ATTEMPTS=10
APPEAL_SUBMISSION_RATE_LIMIT_WINDOW_SECONDS=3600
OPERATOR_OVERDUE_HOURS=24
APPLICANT_MAX_RETURNS=2
EXPERT_COMPOSER_LOCK_TTL_SECONDS=30
ATTACHMENT_STORAGE_PATH=var/private/attachments
ATTACHMENT_MAX_BYTES=10485760
ATTACHMENT_MAX_COUNT=5
ATTACHMENT_MAX_PIXELS=40000000

# Optional staff invitation/password-reset email. No real credentials belong here.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Отклик
SMTP_USE_TLS=true
STAFF_INVITE_TTL_HOURS=24
STAFF_FRONTEND_BASE_URL=http://localhost:3000

# Any phone number or URL must be approved by organizers before production.
CRISIS_SUPPORT_TITLE=Помощь в экстренной ситуации
CRISIS_SUPPORT_MESSAGE=Если прямо сейчас есть угроза жизни или безопасности, обратитесь в местную экстренную службу или к взрослому, которому доверяете.
CRISIS_SUPPORT_PHONE=
CRISIS_SUPPORT_URL=
CRISIS_SUPPORT_REQUIRES_ORGANIZER_VERIFICATION=true

